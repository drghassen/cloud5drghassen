# Copy to terraform.tfvars for local plans. This file contains no secrets.
aws_region   = "eu-west-1"
environment  = "dev"
project_name = "terraform-cloud-project"
owner        = "drghassen"
vpc_cidr     = "10.20.0.0/16"

# One NAT Gateway reduces DEV cost; private app subnets share its egress.
nat_gateway_count = 1

# HTTP uses the ALB's AWS DNS name and needs no custom domain or certificate.
enable_https = false

# AWS Free Tier limits RDS automated backup retention; 0 disables automated backups for DEV.
# Increase to 1-35 on a paid account (TEST/PROD default: 7 days).
db_backup_retention_period = 0
